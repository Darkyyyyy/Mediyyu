{
  "name": "mediyyu",
  "version": "1.4.1",
  "description": "Mediyyu, an audio visualizer desktop app",
  "author": "Darkyyu",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "dmg-license": "^1.0.11",
    "electron": "^38.8.6",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.thedarknightshow.mediyyu",
    "productName": "Mediyyu",
    "publish": {
      "provider": "github",
      "owner": "Darkyyyyy",
      "repo": "Mediyyu"
    },
    "files": [
      ".env",
      "main.js",
      "preload.js",
      "Visualizer.html",
      "lyrics.html",
      "preset-import.html",
      "presets.js",
      "fonts/**/*",
      "assets/**/*",
      "libs/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/cue-sdk/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "ogg",
          "m4a",
          "flac",
          "aac",
          "mid",
          "midi"
        ],
        "name": "Audio File",
        "description": "Audio file",
        "role": "Viewer",
        "icon": "build/fileicon.ico"
      },
      {
        "ext": "mdyp",
        "name": "Mediyyu Preset",
        "description": "Mediyyu preset",
        "role": "Editor",
        "icon": "build/preseticon.ico"
      }
    ],
    "win": {
      "icon": "build/icon-transparent.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "background": "build/appInstalBG.png",
      "iconSize": 80,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 140,
          "y": 165,
          "type": "file"
        },
        {
          "x": 400,
          "y": 165,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/mac-adhoc-sign.js"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "optionalDependencies": {
    "cue-sdk": "^4.0.84"
  }
}
